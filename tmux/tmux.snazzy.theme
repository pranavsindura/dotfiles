# Catppuccin Mocha Theme for tmux

# default statusbar colors
set-option -g status-style bg=#1e1e2e,fg=#cdd6f4

# default window title colors
set-window-option -g window-status-style fg=#a6adc8,bg=default,dim

# active window title colors
set-window-option -g window-status-current-style fg=#cba6f7,bg=default,bright

# pane border
set-option -g pane-border-style fg=#45475a
set-option -g pane-active-border-style fg=#b4befe

# message text
set-option -g message-style bg=#89b4fa,fg=#1e1e2e

# pane number display
set-option -g display-panes-active-colour "#a6e3a1"
set-option -g display-panes-colour "#f9e2af"

# clock
set-window-option -g clock-mode-colour "#cba6f7"

# session name
set -g status-left-length 20
